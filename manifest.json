{
  "manifest_version": 3,
  "name": "TheBash.com Content Reader",
  "version": "1.0.0",
  "description": "A Chrome extension that reads and extracts content from thebash.com",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.thebash.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.thebash.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
